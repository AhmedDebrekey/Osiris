#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform samplerCube environmentMap;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2DArray outIrradiance;

const float PI = 3.14159265359;

// Vulkan cube array layer order: 0=+X 1=-X 2=+Y 3=-Y 4=+Z 5=-Z. Must match
// equirect_to_cubemap.comp's FaceDirection exactly — this indexes the same
// cubemap layout.
vec3 FaceDirection(uint face, vec2 c) {
    switch (face) {
        case 0u: return normalize(vec3( 1.0, -c.y, -c.x));
        case 1u: return normalize(vec3(-1.0, -c.y,  c.x));
        case 2u: return normalize(vec3( c.x,  1.0,  c.y));
        case 3u: return normalize(vec3( c.x, -1.0, -c.y));
        case 4u: return normalize(vec3( c.x, -c.y,  1.0));
        default: return normalize(vec3(-c.x, -c.y, -1.0));
    }
}

void main() {
    ivec3 size = imageSize(outIrradiance);
    ivec3 coord = ivec3(gl_GlobalInvocationID);
    if (coord.x >= size.x || coord.y >= size.y || coord.z >= 6) return;

    vec2 uv = (vec2(coord.xy) + 0.5) / vec2(size.xy);
    vec2 c  = uv * 2.0 - 1.0;
    vec3 normal = FaceDirection(uint(coord.z), c);

    vec3 up    = abs(normal.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 right = normalize(cross(up, normal));
    up = normalize(cross(normal, right));

    // Riemann-sum cosine-weighted hemisphere integral (standard split-sum IBL
    // diffuse term precompute). Irradiance is extremely low-frequency, so a
    // small output resolution (see IRRADIANCE_CUBEMAP_SIZE) is enough despite
    // the coarse sampling here.
    vec3 irradiance = vec3(0.0);
    float sampleCount = 0.0;
    const float sampleDelta = 0.025;

    for (float phi = 0.0; phi < 2.0 * PI; phi += sampleDelta) {
        for (float theta = 0.0; theta < 0.5 * PI; theta += sampleDelta) {
            vec3 tangentSample = vec3(sin(theta) * cos(phi), sin(theta) * sin(phi), cos(theta));
            vec3 sampleVec = tangentSample.x * right + tangentSample.y * up + tangentSample.z * normal;

            irradiance += texture(environmentMap, sampleVec).rgb * cos(theta) * sin(theta);
            sampleCount += 1.0;
        }
    }

    irradiance = PI * irradiance / sampleCount;

    imageStore(outIrradiance, coord, vec4(irradiance, 1.0));
}
